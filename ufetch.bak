# Copyright (c) 2026 João Vitor Duarte <sakaki@tuta.io>
  # (Due to subsequent modifications based on Joe Schillinger's work).

USERNAME="$(basename $HOME)"
HOSTNAME="$(cat /etc/hostname)"
OS="$(grep ^NAME= /etc/os-release | sed 's/NAME=//' | tr -d '"')"
# kernel="$(uname -sr)"
uptime="$(uptime -p | sed 's/up //')"
packages="$(pacman -Q | wc -l)"
shell="${SHELL}"
KERNEL="$(awk '{ print $1, $3}' /proc/version)"
UPTIME="$(uptime -p | sed 's/up //')"
CPU="$(grep ^model\ name /proc/cpuinfo | awk '{ print $4, $5, $6, $7, $8, $9}' | head -n 1)"
CPU_CORES="$(grep ^cpu\ cores /proc/cpuinfo | awk '{ print $4 }' | head -n 1)"
RAM="$(($(cat /proc/meminfo | grep ^MemTotal: | sed 's/MemTotal: *//' | sed 's/kB//')/1024))"
FREE_RAM="$(($RAM-$(cat /proc/meminfo | grep ^MemAvailable: | sed 's/MemAvailable: *//' | sed 's/kB//')/1024))"
SWAP="$(($(cat /proc/meminfo | grep ^SwapTotal: | sed 's/SwapTotal: *//' | sed 's/kB//')/1024))"
SWAP_PAR="$(awk 'NR > 1 { print $1, $5 }' /proc/swaps | sed 's/Filename Priority//')" ; SWAP_FREE="$(($SWAP-$(cat /proc/meminfo | grep ^SwapFree: | sed 's/SwapFree: *//' | sed 's/kB//')/1024))"

if [ -z "${WM}" ]; then
	if [ "${XDG_CURRENT_DESKTOP}" ]; then
		envtype='DE'
		WM="${XDG_CURRENT_DESKTOP}"
	elif [ "${DESKTOP_SESSION}" ]; then
		envtype='DE'
		WM="${DESKTOP_SESSION}"
	else
		envtype='WM'
		WM="$(tail -n 1 "${HOME}/.xinitrc" | cut -d ' ' -f 2)"
	fi
else
	envtype='WM'
fi

# COLORS:
BOLD="$(printf "\033[1m")"
BLACK="$(printf "\033[30m")"
RED="$(printf "\033[31m")"
GREEN="$(printf "\033[32m")"
YELLOW="$(printf "\033[33m")"
BLUE="$(printf "\033[34m")"
MAGENTA="$(printf "\033[35m")"
CYAN="$(printf "\033[36m")"
WHITE="$(printf "\033[37m")"
RESET="$(printf "\033[0m")"
UNDERLINE="$(printf "\033[4m")"

# you can change these
LABELS="${RESET}${BOLD}${CYAN}"		# labels
USER_N_HOST="${RESET}${BOLD}${CYAN}"		# user and hostname
INFO="${RESET}${BOLD}${WHITE}"	# info
COLOR_0="${RESET}${BOLD}${CYAN}"		# first color
COLOR_1="${RESET}${CYAN}"			# second color

USER_EUID="$(printf "\033[0;91m$EUID")"

## OUTPUT

cat <<EOF

${COLOR_0}        /\        ${LABELS}USER:${INFO}      ${UNDERLINE}${USERNAME}@${HOSTNAME}(${USER_EUID}${RESET})
${COLOR_0}       /^^\       ${LABELS}OS:${INFO}        ${OS}${RESET}
${COLOR_0}      /\   \      ${LABELS}KERNEL:${INFO}    ${KERNEL}${RESET}
${COLOR_0}     /  ${c1}__  \     ${lc}UPTIME:    ${ic}${uptime}${reset}
${COLOR_0}    /  (  )  \    ${lc}PACKAGES:  ${ic}${packages}${reset}
${COLOR_0}   / __|  |__\\\\   ${lc}SHELL:     ${ic}${shell}${reset}
${COLOR_0}  ///        \\\\\  ${lc}${envtype}:        ${ic}${WM}${reset}
                  ${lc}LANG:      ${ic}$(echo $LANG)${reset}
                  ${lc}CPU:       ${ic}${CPU}${reset}
                  ${lc}RAM:       ${ic}${FREE_RAM} MiB/${RAM} MiB${reset}
                  ${lc}SWAP:      ${ic}${SWAP_FREE} MiB/${SWAP} MiB${reset}

EOF
